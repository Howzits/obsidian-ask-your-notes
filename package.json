{
  "name": "obsidian-ask-your-notes",
  "version": "1.4.0",
  "description": "Obsidian plugin: chat with any OpenAI-compatible LLM using the active note as context",
  "main": "main.js",
  "scripts": {
    "lint": "eslint main.ts src/",
    "build:brand": "node scripts/build-brand.mjs",
    "test": "node --test tests/*.test.cjs",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "llm",
    "ai",
    "chat",
    "openai",
    "deepseek"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "jsdom": "^31.0.0",
    "obsidian": "latest",
    "prettier": "^3.9.10",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.1"
  }
}
