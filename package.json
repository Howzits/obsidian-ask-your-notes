{
  "name": "obsidian-ask-your-notes",
  "version": "1.2.1",
  "description": "Obsidian plugin: chat with any OpenAI-compatible LLM using the active note as context",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "llm",
    "ai",
    "chat",
    "openai",
    "deepseek"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.5",
    "obsidian": "latest",
    "tslib": "^2.6.3",
    "typescript": "^5.5.0"
  }
}
